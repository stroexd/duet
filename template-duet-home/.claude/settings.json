{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "duet-lokal": {
      "source": {
        "source": "github",
        "repo": "stroexd/duet"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "duet@duet-lokal": true
  },
  "enabledMcpjsonServers": [
    "duet"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "uvx",
            "args": [
              "--from",
              "git+https://github.com/stroexd/duet",
              "duet-hook",
              "--source",
              "project"
            ],
            "timeout": 120
          }
        ]
      }
    ]
  }
}
